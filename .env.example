# Use sandbox credentials during development. Switch to live only after sandbox checkout tests pass.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_your_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_your_paypal_client_secret
# Webhook ID shown by PayPal after registering /api/paypal/webhook for this app.
PAYPAL_WEBHOOK_ID=replace_with_your_paypal_webhook_id

# Admin accounts live in MySQL. This secret signs the HTTP-only admin session.
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret

# Optional dedicated signing key for durable private receipt links. If omitted,
# the app falls back to ADMIN_SESSION_SECRET or PAYPAL_CLIENT_SECRET.
# RECEIPT_SECRET=replace_with_another_random_secret_at_least_32_characters_long

# Authorizes a hosting cron job to reconcile PayPal and remove abandoned orders.
ORDER_MAINTENANCE_SECRET=replace_with_a_different_random_secret_at_least_32_characters_long

# MySQL or MariaDB connection string. Keep credentials server-side. When this
# is omitted, the app uses the separate DB_* variables supplied by GoDaddy.
DATABASE_URL=mysql://username:password@127.0.0.1:3306/yg_cornhole
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=yg_cornhole
# DB_USER=username
# DB_PASSWORD=password

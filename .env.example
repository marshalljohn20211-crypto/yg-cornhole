# Use sandbox credentials during development. Switch to live only after sandbox checkout tests pass.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_your_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_your_paypal_client_secret

# Use a strong password and a random secret of at least 32 characters.
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret

# PostgreSQL connection string. Keep credentials server-side.
DATABASE_URL=postgresql://username:password@localhost:5432/yg-cornhole
# Set to "require" when your hosted PostgreSQL provider requires TLS.
DATABASE_SSL=
